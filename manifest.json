{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.5",
  "author": "Nicola Ferralis",
  "homepage_url": "https://github.com/feranick/Thunderbird-Yahoo-Mail-Tab/",
  "browser_specific_settings": {
    "gecko": {
      "id": "feranick.yahoo-mail-tab@addons.thunderbird.net",
      "strict_min_version": "106.0"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "https://*.yahoo.com/*",
    "tabs",
    "notifications",
    "storage"
  ],
  "default_locale": "en",
  "icons": {
    "32": "skin/yahoo_mail_icon.svg",
    "48": "skin/yahoo_mail_icon.svg",
    "96": "skin/yahoo_mail_icon.svg"
  },
  "options_ui": {
    "page": "options.html"
  },
  "background": {
    "scripts": [
      "redirect.js"
    ]
  }
}
